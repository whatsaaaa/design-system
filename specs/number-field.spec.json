{
  "$schema": "./spec.schema.json",
  "component": "number-field",
  "title": "Number field",
  "status": "draft",
  "summary": "A number, in a field with its label above it and its help or its error under it: the input's edge, height and value, with a named button inside the edge on each side that steps the value down or up.",
  "use": [
    "A quantity that is counted, and often changed by one: a number of tickets, of guests, of nights.",
    "Always inside its form field: a number field is never shown without its label."
  ],
  "notFor": [
    "A number that is not a quantity, such as a phone number, a postal code or a card number: that is an input, with the `inputmode` of its digits.",
    "A value from a range where the exact number matters less than where it lies, such as a volume: that is a slider, which the system does not specify yet.",
    "A value that cannot be changed, such as on a review step: that is a list of terms and values, `ws-pairs`."
  ],
  "parts": {
    "root": "The box, and the number typed in it: the native input element.",
    "placeholder": "Text in an empty box. The system uses none: a hint goes under the field.",
    "decrement": "The button at the start of the box that steps the value down: a native button with its name.",
    "decrement-icon": "The minus icon of the decrement button.",
    "increment": "The button at the end of the box that steps the value up: a native button with its name.",
    "increment-icon": "The plus icon of the increment button.",
    "label": "The field's name, above the box.",
    "required": "The asterisk after the label of a field that must be filled in.",
    "help": "The help under the box: what to enter, or why.",
    "error": "The error under the box, in place of the help: what is wrong and how to fix it.",
    "error-icon": "The danger icon before the error."
  },
  "variants": {
    "outline": "The one look of a field: an edge in the field border, on the page color."
  },
  "sizes": {
    "xs": "A dense row, such as a quantity in a table's row.",
    "sm": "A bar or a toolbar, such as how many rows a page shows.",
    "md": "Every other number field: a form, a dialog.",
    "lg": "A form of one or two fields that a page leads to, such as the number of tickets on a sign-up.",
    "xl": "A landing page's one field, such as how many people are coming."
  },
  "defaultSize": "md",
  "states": {
    "rest": "Nothing is on it.",
    "hover": "The pointer is on it.",
    "focus": "It has the focus, as `:focus-visible` says, which a text field has from a click too.",
    "invalid": "Its value is wrong: `aria-invalid` is true, and the error is under it.",
    "disabled": "It cannot be changed now."
  },
  "icons": {
    "decrement": "minus",
    "increment": "plus",
    "error": "octagon-alert"
  },
