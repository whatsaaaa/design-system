{
  "$schema": "./spec.schema.json",
  "component": "badge",
  "title": "Badge",
  "status": "draft",
  "summary": "A short word next to what it describes, the system's tag: a mono label on a tint of its color for a status or a category, or in an edge for a plain list.",
  "use": [
    "A status next to what it describes, such as paid, pending or cancelled in a table's cell.",
    "A category or a name in a list of them, such as the technologies of a project: the tag, or the outlined tag where a list of tints would be loud."
  ],
  "notFor": [
    "An action: that is a button, which a badge never looks like.",
    "A count or a dot on an icon or an avatar.",
    "A message about the page: that is a callout, or a status line."
  ],
  "parts": {
    "root": "The box: the tint or the edge, and the room around the word.",
    "label": "The word.",
    "leading-icon": "An icon before the word, which repeats what it says, such as a check before paid.",
    "trailing-icon": "An icon after the word."
  },
  "variants": {
    "primary": "The tag, on a tint of the interactive color: a category or a label, such as new or a technology. `.ws-tag` is this kind at md.",
    "success": "A status that went well: paid.",
    "info": "A status that waits: pending.",
    "warning": "A status that needs attention soon: expiring.",
    "danger": "A status that failed or ended: cancelled.",
    "neutral": "A plain fact without a status: draft.",
    "outline": "The outlined tag, in the text color, for a plain list where tints would be loud, such as a project's stack. `.ws-tag--outline` is this kind at md."
  },
  "sizes": {
    "xs": "A dense row, next to a caption.",
    "sm": "Next to a small control, or in a bar.",
    "md": "Every other badge: in text, in a table's cell, in a card's header. The size of `.ws-tag`.",
    "lg": "Next to a large control or a minor heading.",
    "xl": "Next to the title of a landing page."
  },
  "defaultSize": "md",
  "states": {
    "rest": "Always: a badge is not interactive, so it has no other state."
  },
