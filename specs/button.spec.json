{
  "$schema": "./spec.schema.json",
  "component": "button",
  "title": "Button",
  "status": "draft",
  "changed": "0.9.0",
  "summary": "An action: a mono label in semibold, in a box of the control height, filled with the interactive color for the one action a view leads to and outlined for the rest.",
  "use": [
    "An action on the page: submit a form, save, open a dialog, delete.",
    "One primary button in a view, for the action it leads to. Every other action is secondary, ghost or quiet."
  ],
  "notFor": [
    "Going to another page: that is a link.",
    "Choosing one of a few options: that is a segmented control or radio buttons.",
    "A status: that is a tag."
  ],
  "parts": {
    "root": "The box that takes the pointer and the focus: the native button element.",
    "label": "The text, which says what the button does.",
    "leading-icon": "An icon before the label, and the turning loading icon of a loading button.",
    "trailing-icon": "An icon after the label, such as an arrow to the next step."
  },
  "variants": {
    "primary": "The one action a view leads to, such as Register or Save: a fill of the interactive color. At most one in a view.",
    "secondary": "Every other action, such as Cancel or Back: an edge in the field border, raised under the pointer.",
    "ghost": "A minor action next to another, such as Later in a card's footer: no edge until the pointer is on it.",
    "quiet": "An action that reads as a link, inside text or a dense row, such as Edit: the interactive color, underlined, with no box.",
    "danger": "An action that deletes something or cannot be undone, such as Delete registration: an outline in the danger color, in both themes."
  },
  "sizes": {
    "xs": "A dense row, such as a table's actions.",
    "sm": "A bar or a toolbar, such as a modal's close button.",
    "md": "Every other button: a form, a dialog, a card.",
    "lg": "A page that leads to one action, such as a sign-up's Register.",
    "xl": "A landing page's one call to action."
  },
  "defaultSize": "md",
  "states": {
    "rest": "Nothing is on it.",
    "hover": "The pointer is on it.",
    "active": "It is pressed, by the pointer or by Enter or Space.",
    "focus": "It has the keyboard's focus, as `:focus-visible` says.",
    "disabled": "It cannot be used now.",
    "loading": "Its action is running: it is disabled, keeps its look, and its leading icon turns."
  },
  "icons": {
    "loading": "loader-circle"
  },
