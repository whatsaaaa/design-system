{
  "$schema": "./spec.schema.json",
  "component": "select",
  "title": "Select",
  "status": "draft",
  "summary": "One choice from a list: a field that shows the choice, with a chevron at its end, and the list of options that opens under it on a panel of the overlay.",
  "use": [
    "One choice from a list too long for radio buttons, more than about five options: a city, a day, a country.",
    "Always inside its form field, with its label above it and its help or its error under it, as the input spec draws them."
  ],
  "notFor": [
    "A few options, about five or fewer, that read better side by side: that is a radio group.",
    "A list long enough that a reader would rather type than scroll, or several choices at once: that is a select menu, with a search.",
    "An action: that is a button, or a menu of them."
  ],
  "parts": {
    "root": "The trigger: the box, and the choice shown in it.",
    "placeholder": "Text in the trigger before anything is chosen. The system uses none: the help says what to choose.",
    "leading-icon": "An icon before the choice, and the turning loading icon of a loading select.",
    "trailing-icon": "The chevron at the end of the trigger, which says a list opens.",
    "content": "The list: a panel of the overlay under the trigger, as wide as it is.",
    "group": "A group of options, and the room around them.",
    "group-label": "A group's name, above its options: an overline.",
    "item": "An option, its label in the value's type.",
    "item-highlight": "What marks the option the pointer or the arrow keys are on: a fill under it, inside its box.",
    "item-indicator": "The tick after the chosen option.",
    "separator": "The line between two groups."
  },
  "variants": {
    "outline": "The one look of a field: an edge in the field border, on the page color."
  },
  "sizes": {
    "xs": "A dense row, such as a filter in a table's head.",
    "sm": "A bar or a toolbar.",
    "md": "Every other field: a form, a dialog.",
    "lg": "A form of one or two fields that a page leads to, such as a sign-up.",
    "xl": "A landing page's one field."
  },
  "defaultSize": "md",
  "states": {
    "rest": "Nothing is on it, and its list is closed.",
    "hover": "The pointer is on the trigger.",
    "focus": "The trigger has the keyboard's focus, as `:focus-visible` says.",
    "invalid": "Its choice is wrong or missing: `aria-invalid` is true, and the error is under it.",
    "disabled": "It cannot be changed now.",
    "loading": "Its options are being loaded: the leading icon turns.",
    "open": "Its list is open under the trigger, on the option chosen, which is highlighted: the first, in a gallery."
  },
  "icons": {
    "open": "chevron-down",
    "chosen": "check",
    "loading": "loader-circle"
  },
