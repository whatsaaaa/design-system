{
  "$schema": "./spec.schema.json",
  "component": "textarea",
  "title": "Text area",
  "status": "draft",
  "summary": "Text of several lines, in a field with its label above it and its help or its error under it: the input's edge, value and field, with rows of text in place of its one line and no height of its own.",
  "use": [
    "Text of more than one line: a message, a note to the organizer, a description.",
    "Always inside its form field: a text area is never shown without its label."
  ],
  "notFor": [
    "One line of text, such as a name or an email address: that is an input.",
    "Text with formatting, such as headings and lists: that is an editor, which the system does not specify.",
    "A value that cannot be changed, such as on a review step: that is a list of terms and values, `ws-pairs`."
  ],
  "parts": {
    "root": "The box, and the text typed in it: the native textarea element.",
    "placeholder": "Text in an empty box. The system uses none: a hint goes under the field.",
    "label": "The field's name, above the box.",
    "required": "The asterisk after the label of a field that must be filled in.",
    "help": "The help under the box: what to enter, or why.",
    "error": "The error under the box, in place of the help: what is wrong and how to fix it.",
    "error-icon": "The danger icon before the error."
  },
  "variants": {
    "outline": "The one look of a field: an edge in the field border, on the page color."
  },
  "sizes": {
    "xs": "A dense panel, such as a note beside a table's row.",
    "sm": "A bar or a side panel, such as a comment in a toolbar.",
    "md": "Every other text area: a form, a dialog.",
    "lg": "A form of one or two fields that a page leads to, such as a contact form's message.",
    "xl": "A page whose one field is the text, such as a feedback page."
  },
  "defaultSize": "md",
  "states": {
    "rest": "Nothing is on it.",
    "hover": "The pointer is on it.",
    "focus": "It has the focus, as `:focus-visible` says, which a text field has from a click too.",
    "invalid": "Its value is wrong: `aria-invalid` is true, and the error is under it.",
    "disabled": "It cannot be changed now."
  },
  "icons": {
    "error": "octagon-alert"
  },
