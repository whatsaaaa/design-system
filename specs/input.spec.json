  "keyboard": [
    {
      "keys": ["Tab", "Shift+Tab"],
      "effect": "Moves the focus into the field and on to the next or the previous control. A disabled field is skipped."
    },
    {
      "keys": ["Enter"],
      "effect": "Sends the form the field is in, where the form has a submit button, as the browser does."
    }
  ],
  "aria": {
    "pattern": "https://html.spec.whatwg.org/multipage/input.html",
    "rules": [
      "It is a native input element with the type of its value, such as email or tel, and an autocomplete where the browser can fill it in.",
      "The label is a label element for the input: its accessible name.",
      "The help and the error are its description, by `aria-describedby`. While the error shows it takes the help's place.",
      "A field in error has `aria-invalid` true. Its error says how to fix it, and is never a color alone: it has its word and its icon.",
      "A required field has the required attribute, which assistive technology reads; the asterisk shows it.",
      "A disabled field is the native disabled attribute."
    ]
  },
  "forcedColors": [
    "The edge is a real border, which forced colors keep in the system's colors, and in `GrayText` when the field is disabled.",
    "The focus ring is an outline, which forced colors keep.",
    "The error icon takes the system's text color, as the error's word does, so both still say it is an error."
  ],
  "motion": [
    "The edge changes color in `motion.duration.fast`, with `motion.easing.standard`. With `prefers-reduced-motion: reduce` it changes at once.",
    "The loading icon turns only with `prefers-reduced-motion: no-preference`."
  ],
  "content": [
    "The label names the value, in sentence case and with no colon: Full name, Email address.",
    "No placeholders. What to enter goes in the help under the field: As on your ID.",
    "An error says how to fix it, not only what is wrong: Enter an email address with a domain, such as maya@example.com."
  ],
  "notes": [
    "Read-only is not specced: a value that cannot be changed, as on a review step, is shown as a term and its value, with `ws-pairs`.",
    "Nuxt UI's hint, beside the label, is not part of the spec: hints go under the field, as its help.",
    "The value starts past an icon by the field's padding, the icon and the control's gap, so the padding on the side of an icon is the three together, as the rows with that icon say.",
    "The value and the icons keep their place when the edge widens: an invalid field's padding is its padding at rest less the extra edge, `control.border-width.invalid` less `control.border-width.rest`, so its edge grows inward over the padding and nothing in the box moves."
  ],
  "implementations": {
    "ui-vue": {
      "library": "Nuxt UI 4.12, themed by ui-vue's app config",
      "status": "shipped",
      "parity": "none",
      "components": ["UInput", "UFormField"],
      "today": "The outline variant, inside a form field, in Nuxt UI's five sizes. Its heights, paddings, value sizes, edge colors, focus ring, label, help and error already match the spec, and its icons are 16 px up to md and 20 px above. It reads the system's roles through Tailwind utilities, not the component tokens yet.",
      "parts": {
        "root": "base",
        "placeholder": "base::placeholder",
        "leading-icon": "leadingIcon",
        "trailing-icon": "trailingIcon",
        "label": "label",
        "required": "label::after",
        "help": "help",
        "error": "error",
        "error-icon": "error::before"
      },
      "variants": {
        "outline": {
          "variant": "outline"
        }
      },
      "sizes": {
        "xs": {
          "size": "xs"
        },
        "sm": {
          "size": "sm"
        },
        "md": {
          "size": "md"
        },
        "lg": {
          "size": "lg"
        },
        "xl": {
          "size": "xl"
        }
      },
      "deviations": [
        {
          "summary": "The edge is an inset ring, a box shadow, and a border only in forced colors. So the rows for `border-color`, `border-style` and `border-width` do not hold."
        },
        {
          "summary": "The required mark is `color.brand`, 3.84:1 on the light page, under the 4.5:1 of small text. The spec takes `field.required.text`, the darker red of the light theme, 4.73:1."
        },
        {
          "summary": "A placeholder is `color.text-faint`, 3.42:1 in the dark theme and 4.02:1 in the light. The spec uses no placeholders, and gives one that an app passes anyway `color.text-secondary`."
        },
        {
          "summary": "The error icon is the system's own danger glyph, drawn as a mask that fills its background with `field.error.icon` while its color is the error's. The spec names Lucide's `octagon-alert` in `currentcolor`."
        },
        {
          "summary": "It reads the roles by their Tailwind utilities, such as `ring-field-border`, not the component tokens, such as `ring-(--ws-field-border-rest)`, so a change of the tier does not reach it."
        },
        {
          "summary": "Its gallery shows the states and the sizes of the contract, but marks none of them with `data-spec`, so no test can find them by id yet."
        }
      ],
      "beyond": [
        "The variants soft, subtle and ghost, and none, the bare field inside another control such as a select menu's search.",
        "The highlight prop, which outlines a field in a color."
      ]
    },
    "ui-react": {
      "library": "shadcn/ui on Radix",
      "status": "planned",
      "parity": "none"
    }
