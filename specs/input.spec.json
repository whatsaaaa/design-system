{
  "$schema": "./spec.schema.json",
  "component": "input",
  "title": "Input",
  "status": "draft",
  "changed": "0.11.1",
  "summary": "One line of text, in a field with its label above it and its help or its error under it: the value in Inter, an edge in the field border, the control height.",
  "use": [
    "One line of text: a name, an email address, a number, a date typed out.",
    "Always inside its form field: an input is never shown without its label."
  ],
  "notFor": [
    "Text of more than one line: that is a text area.",
    "One choice from a list: that is a select, or radio buttons for a few options.",
    "A value that cannot be changed, such as on a review step: that is a list of terms and values, `ws-pairs`."
  ],
  "parts": {
    "root": "The box, and the value typed in it: the native input element.",
    "placeholder": "Text in an empty box. The system uses none: a hint goes under the field.",
    "leading-icon": "An icon before the value, such as a mail icon, and the turning loading icon of a loading field.",
    "trailing-icon": "An icon after the value.",
    "label": "The field's name, above the box.",
    "required": "The asterisk after the label of a field that must be filled in.",
    "help": "The help under the box: what to enter, or why.",
    "error": "The error under the box, in place of the help: what is wrong and how to fix it.",
    "error-icon": "The danger icon before the error."
  },
  "variants": {
    "outline": "The one look of a field: an edge in the field border, on the page color."
  },
  "sizes": {
    "xs": "A dense row, such as a filter in a table's head.",
    "sm": "A bar or a toolbar.",
    "md": "Every other field: a form, a dialog.",
    "lg": "A form of one or two fields that a page leads to, such as a sign-up.",
    "xl": "A landing page's one field, such as a search."
  },
  "defaultSize": "md",
  "states": {
    "rest": "Nothing is on it.",
    "hover": "The pointer is on it.",
    "focus": "It has the focus, as `:focus-visible` says, which a text field has from a click too.",
    "invalid": "Its value is wrong: `aria-invalid` is true, and the error is under it.",
    "disabled": "It cannot be changed now.",
    "loading": "Its value is being checked: the leading icon turns, and the field can still be typed in."
  },
  "icons": {
    "loading": "loader-circle",
    "error": "octagon-alert"
  },
